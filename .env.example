# ── Backend ──────────────────────────────────────────────────────────────────
# SQLite database file (kept inside the app-data volume under compose)
DATABASE_URL=/app/data/sentinel.db

# clamd service (leave CLAMD_HOST empty to skip clamd scans)
CLAMD_HOST=clamd
CLAMD_PORT=3310

# External provider API keys (leave empty to skip that provider)
VIRUSTOTAL_API_KEY=
ALIENVAULT_API_KEY=
ABUSECH_API_KEY=

# Purge "clean" scans older than N days
CLEAN_TTL_DAYS=30

# Reuse a previous verdict for an IoC scanned within the last N hours
CACHE_TTL_HOURS=24

# Optional container user IDs (defaults to 10001 in Compose)
# APP_UID=10001
# APP_GID=10001

# Quarantine malicious copies in persistent backend storage.
# Default: a quarantine directory beside DATABASE_URL.
# QUARANTINE_DIR=/app/data/quarantine

# Linux only: host folder mounted by the optional ClamAV on-access profile.
# The requested default is ~/Download; override this if your system uses ~/Downloads.
# ONACCESS_DOWNLOAD_DIR=/home/your-user/Download
